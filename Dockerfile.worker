# syntax=docker/dockerfile:1
#
# CLI-only image for Yuno PaaS. Unlike the default Dockerfile (which builds the
# web app + runs the server), this builds just the `promptfoo` CLI (tsdown →
# dist/src/entrypoint.js) and adds awscli so a pentest-worker K8s Job can run
# `promptfoo redteam run` against a target and sync the JSON report to S3.
#
# Red-team generation + grading run fully LOCAL against the AI provider the
# worker injects (Claude-OAuth / Anthropic-key / OpenAI / Gemini) — the worker
# sets PROMPTFOO_DISABLE_REDTEAM_REMOTE_GENERATION=1 so nothing is sent to
# promptfoo's cloud (respects the egress lockdown).
FROM node:24.21.0-alpine AS base
RUN apk upgrade --no-cache && \
    apk add --no-cache python3 py3-pip curl bash aws-cli libc6-compat && \
    ln -sf python3 /usr/bin/python

FROM base AS builder
WORKDIR /app
ENV VITE_IS_HOSTED=1 \
    VITE_TELEMETRY_DISABLED=1 \
    NODE_OPTIONS=--max-old-space-size=4096
# Install deps deterministically (workspace manifests first for a reproducible
# root lockfile install), blocking lifecycle scripts, then rebuild esbuild which
# tsdown needs.
COPY package.json package-lock.json ./
COPY src/app/package.json ./src/app/package.json
COPY site/package.json ./site/package.json
RUN --mount=type=cache,target=/root/.npm \
    npm ci --install-links --include=peer --ignore-scripts && \
    npm rebuild ./node_modules/esbuild
COPY . .
# CLI/runtime build — tsdown emits dist/src/entrypoint.js (the bin). Skip
# build:app (web UI) and tsc (type-check, --noEmit) since the Job never serves
# the UI. Use the worker config (dts:false) — the dts (tsgo) pass is what OOMs
# the builder; the JS bundles themselves are cheap.
RUN NODE_OPTIONS=--max-old-space-size=4096 npx tsdown -c tsdown.worker.config.ts && \
    cp -r drizzle dist/drizzle
# ^ promptfoo runs drizzle/libsql migrations at startup and needs dist/drizzle
# (meta/_journal.json + .sql). We copy it directly instead of scripts/postbuild.ts
# because postbuild hard-fails when the .d.ts outputs are absent (we build dts:false
# to fit memory). The python/ruby/golang provider wrappers postbuild also copies are
# not needed here — the red-team uses http + anthropic/openai/google providers only.

FROM base AS worker
WORKDIR /app
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/dist ./dist
RUN ln -sf /app/dist/src/entrypoint.js /usr/local/bin/promptfoo && \
    ln -sf /app/dist/src/entrypoint.js /usr/local/bin/pf && \
    chmod +x /app/dist/src/entrypoint.js
# Quiet + local by default. Remote red-team generation (api.promptfoo.app) is
# DISABLED here because it requires a verified promptfoo account email — without
# one the /task endpoint rejects everything and fails all plugins. Local
# generation (our own LLM) covers the simpler plugins. The worker re-enables
# remote per-Job via enable_remote_generation ONLY with a verified account.
ENV PROMPTFOO_RUNNING_IN_DOCKER=1 \
    PROMPTFOO_DISABLE_TELEMETRY=1 \
    PROMPTFOO_DISABLE_UPDATE=1 \
    PROMPTFOO_DISABLE_REDTEAM_REMOTE_GENERATION=1 \
    PROMPTFOO_SELF_HOSTED=1
ENTRYPOINT []
CMD ["sh"]
